# Safe default: data routes refuse requests until real adapters are implemented.
ITDA_MODE=production
# For disposable local demo only: ITDA_MODE=fixture
# Fixture API uses Bearer fixture-user-a or fixture-user-b. Never deploy fixture mode.
ITDA_ENVIRONMENT=local
ITDA_SUPABASE_URL=
ITDA_SUPABASE_SERVICE_ROLE_KEY=
ITDA_LLM_API_KEY=
ITDA_FCM_CREDENTIALS_PATH=

