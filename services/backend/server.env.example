# Copy to the ignored .env in services/backend or set these in the server process.
ITDA_MODE=production
ITDA_ENVIRONMENT=local
ITDA_DATABASE_URL=
ITDA_SUPABASE_URL=
ITDA_SUPABASE_JWT_ISSUER=
ITDA_SUPABASE_JWT_ALGORITHM=
# Set the JWKS URL for asymmetric signatures or the JWT secret for local HS256.
ITDA_SUPABASE_JWKS_URL=
ITDA_SUPABASE_JWT_SECRET=
# Server-only. Use a separate random cursor secret for each database and Auth realm.
ITDA_SYNC_CURSOR_SECRET=
ITDA_SUPABASE_SERVICE_ROLE_KEY=
# Optional hosted text and vision inference.
ITDA_LLM_API_KEY=
ITDA_LLM_MODEL=gemini-3.8-flash
