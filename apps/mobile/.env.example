# Documentation only. Export these variables in the Android build shell.
# Run with --dart-define=ITDA_DATA_MODE=fixture (default).
ITDA_DATA_MODE=fixture
# Choose disabled, mock, staging, or live. Mock and staging are debug-only.
ITDA_UPLOAD_MODE=disabled
# Mock or live settings. Set only the group for the selected environment.
ITDA_API_BASE_URL=
ITDA_SUPABASE_URL=
ITDA_SUPABASE_PUBLISHABLE_KEY=
# Staging settings. Use the API and Supabase project approved for this stage.
ITDA_STAGING_API_BASE_URL=
ITDA_STAGING_SUPABASE_URL=
ITDA_STAGING_SUPABASE_PUBLISHABLE_KEY=
