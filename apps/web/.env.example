# Fixture mode runs with synthetic content and no credentials.
ITDA_DATA_MODE=fixture

# Use api mode only with a FastAPI instance that verifies Supabase user JWTs.
ITDA_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Set a publishable key or the legacy anon key from the same Supabase project as Android.
# Never use a service-role/secret key or paste an access token.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
