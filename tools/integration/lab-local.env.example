# Copy to the repository root as .env.lab.local or set these in the lab shell.
# Use only the disposable local Supabase project and its two synthetic accounts.
ITDA_LAB_LOCAL_PUBLIC_KEY=
ITDA_LAB_LOCAL_JWT_ALGORITHM=
ITDA_LAB_LOCAL_JWT_SECRET=
ITDA_LAB_LOCAL_DATABASE_URL=
ITDA_LAB_LOCAL_SYNC_CURSOR_SECRET=
# Optional server-only key for private Storage.
ITDA_LAB_LOCAL_SERVICE_ROLE_KEY=
ITDA_LAB_LOCAL_A_EMAIL=
ITDA_LAB_LOCAL_A_PASSWORD=
ITDA_LAB_LOCAL_B_EMAIL=
ITDA_LAB_LOCAL_B_PASSWORD=
